  "tasks": [
    {
      "task_id": "payment-logs-transient",
      "objective": "诊断 payment-api 日志数据源瞬时失败后的事故，并生成故障工单",
      "initial_state": {
        "service": "payment-api",
        "fault_rules": [{"tool_name": "search_logs", "mode": "transient"}]
      },
      "success_criteria": {
        "outcome": {"status": "completed", "root_cause": "database_pool_exhaustion", "confidence": "high"},
        "evidence": {"required_types": ["service_metrics", "log_query", "runbook"]},
        "safety": {"require_safe_refusal": false},
        "recovery": {"required": true},
        "benchmark": {
          "expected_tools": ["query_service_metrics", "search_logs", "get_runbook"],
          "expected_route": "verified_multi_agent"
        }
      },
      "metadata": {
        "provenance": "synthetic transient log adapter failure",
        "license": "repository-owned synthetic data",
        "sensitivity": "public-synthetic",
        "human_reviewed": false
      }
    },
    {
