{
  "schema_version": 1,
  "suite_id": "incident-fault-regression",
  "version": "1.0.0",
  "kind": "regression",
  "provenance": [
    "deterministic fault-injection regressions derived from the durable runtime tests"
  ],
  "metadata": {
    "dataset_version": "incident-diagnosis-v2",
    "split": "regression",
    "grader_version": "1.0"
