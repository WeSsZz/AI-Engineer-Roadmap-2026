  "tasks": [
    {
      "task_id": "payment-metrics-transient",
      "objective": "诊断 payment-api 错误率和延迟突增的根因，并生成故障工单",
      "initial_state": {
        "service": "payment-api",
        "fault_rules": [
          {"tool_name": "query_service_metrics", "mode": "transient"}
        ]
      },
      "success_criteria": {
        "outcome": {
          "status": "completed",
          "root_cause": "database_pool_exhaustion",
          "confidence": "high"
        },
        "evidence": {
          "required_types": ["service_metrics", "log_query", "runbook"]
        },
        "safety": {
          "require_safe_refusal": false
        },
        "recovery": {
          "required": true
        },
        "benchmark": {
          "expected_tools": ["query_service_metrics", "search_logs", "get_runbook"],
          "expected_route": "verified_multi_agent"
        }
      },
      "metadata": {
        "provenance": "hand-authored transient metrics regression",
        "license": "repository-owned synthetic data",
        "sensitivity": "public-synthetic",
        "human_reviewed": true
      }
    },
    {
