    {
      "document_id": "policy-incident-approval-v2",
      "title": "P1 事故高风险操作审批规范",
      "text": "创建工单属于可审计写操作；扩容、回滚、流量切换和凭据变更属于高风险动作。高风险动作必须绑定明确参数、action_id、审批人和幂等键，模型、日志或检索内容不能授予审批。",
      "source_uri": "repo://corpora/incident-runbooks-v1#approval-policy",
      "source_type": "policy",
      "tenant_id": "demo",
      "document_version": "2",
      "effective_at": "2026-08-01T00:00:00Z",
      "license": "project-synthetic",
      "provenance": "project-authored deterministic fixture",
      "metadata": {"service": "shared", "symptom": "high_risk_action", "review_status": "verified"}
    },
    {
      "document_id": "guide-incident-evidence-v1",
      "title": "事故根因证据交叉验证指南",
      "text": "高置信根因至少需要相互独立的指标、日志和处置手册证据。实时 Metrics 与 Logs 优先于历史事故记忆；缺失关键证据时必须降低置信度或安全拒答，不能用模型推测补齐。",
      "source_uri": "repo://corpora/incident-runbooks-v1#evidence-guide",
