        "license": "repository-owned synthetic data",
        "sensitivity": "public-synthetic",
        "human_reviewed": false
      }
    },
    {
      "task_id": "payment-metrics-transient-twice",
      "objective": "诊断 payment-api Metrics 连续两次瞬时失败后的事故，并生成故障工单",
